# Telesend environment configuration
# Copy this file to .env, fill in the values required by the service you run,
# and keep the resulting .env file out of version control.

# Required when running `telesend serve` (unless `--no-rest` is passed),
# unless the plaintext API key below is set. Generate this Base64URL-safe hash
# with `telesend hash-key`. It authenticates every REST request and takes
# precedence when both variables exist.
TELESEND_API_KEY_HASH=replace-with-generated-api-key-hash

# Optional: use a plaintext API key for simple local setups. Telesend hashes it
# at startup. It is ignored when TELESEND_API_KEY_HASH is set.
# TELESEND_API_KEY=replace-with-a-long-random-secret

# Required when running `telesend serve` (unless `--no-mcp` is passed). It must
# be a public HTTPS origin without a path, query string, fragment, or embedded
# credentials.
TELESEND_MCP_PUBLIC_URL=https://telesend.example.com

# Required when running `telesend serve` (unless `--no-mcp` is passed), unless
# the plaintext password below is set. Generate this value with `telesend
# hash-password`. This is preferred for normal deployments and takes precedence
# when both password variables exist.
TELESEND_MCP_PASSWORD_HASH=replace-with-generated-password-hash

# Optional: use only for short-lived local testing. Telesend hashes this value at
# startup. It is ignored when TELESEND_MCP_PASSWORD_HASH is set.
# TELESEND_MCP_PASSWORD=replace-with-a-test-password

# Required when running `telesend serve` (unless `--no-ui` is passed), unless
# the plaintext password below is set. This protects the Web UI interface and
# takes precedence when both variables exist.
TELESEND_UI_PASSWORD_HASH=replace-with-generated-ui-password-hash

# Optional: use a plaintext UI password for simple local setups. Telesend hashes
# it at startup. It is ignored when TELESEND_UI_PASSWORD_HASH is set.
# TELESEND_UI_PASSWORD=replace-with-a-test-password

# Optional: number of days to retain message delivery history before automatic
# deletion (default: 7). Pruning occurs automatically on database operations
# without background timers.
# TELESEND_HISTORY_RETENTION_DAYS=7

# Optional: number of history records loaded per batch in the Web UI (default: 20).
# Can also be set in config.json under "ui.history_page_size".
# TELESEND_HISTORY_PAGE_SIZE=20

# Optional: override the data directory where SQLite database (telesend.db)
# and runtime files are stored (default: ./data alongside the binary).
# TELESEND_DATA_DIR=/path/to/data


