# Telesend environment configuration
# Copy this file to .env, fill in the values required by the service you run,
# and keep the resulting .env file out of version control.

# Required when running `telesend serve`. This authenticates every REST request.
TELESEND_API_KEY=replace-with-a-long-random-secret

# Required when running `telesend mcp-serve`. It must be a public HTTPS origin
# without a path, query string, fragment, or embedded credentials.
TELESEND_MCP_PUBLIC_URL=https://telesend.example.com

# Required when running `telesend mcp-serve` unless the plaintext password below
# is set. Generate this value with `bun run mcp:hash-password`. This is preferred
# for normal deployments and takes precedence when both password variables exist.
TELESEND_MCP_OWNER_PASSWORD_HASH=replace-with-generated-password-hash

# Optional: use only for short-lived local testing. Telesend hashes this value at
# startup. It is ignored when TELESEND_MCP_OWNER_PASSWORD_HASH is set.
# TELESEND_MCP_OWNER_PASSWORD=replace-with-a-test-password
